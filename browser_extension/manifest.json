{
  "manifest_version": 3,
  "name": "MeetingGist",
  "version": "1.0.0",
  "description": "Record meeting audio and generate a meeting summary.",
  "permissions": ["storage", "offscreen", "notifications"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MeetingGist"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html"
}
